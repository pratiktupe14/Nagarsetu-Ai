# ==============================================================================
# NAGARSETU 3.1 — Frontend Environment Variables (.env.example)
# Service: React + Vite Single-Page Application
# Deployment: Vercel (Production) / Vite Dev Server (Local)
#
# NOTE: All frontend variables MUST start with VITE_ to be exposed to the browser.
# NEVER place backend secrets, private keys, database URLs, or service role keys here!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Express Backend API Base URL
# ------------------------------------------------------------------------------
# In Local Dev: http://localhost:5000
# In Vercel Production: https://backend-teal-omega-46.vercel.app (your deployed backend domain)
# Either VITE_API_URL or VITE_API_BASE_URL is accepted by apiConfig.ts
VITE_API_URL=https://your-backend-domain.vercel.app
VITE_API_BASE_URL=https://your-backend-domain.vercel.app

# ------------------------------------------------------------------------------
# 2. Supabase Client Configuration (Public Anon Key only)
# ------------------------------------------------------------------------------
# Used for direct client-side realtime / public storage download URLs
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-jwt-key

# ------------------------------------------------------------------------------
# 3. Google Maps JavaScript API (Client Browser)
# ------------------------------------------------------------------------------
# Must be restricted in Google Cloud Console to your frontend domains (HTTP referrers)
VITE_GOOGLE_MAPS_API_KEY=your-restricted-google-maps-browser-api-key
VITE_GOOGLE_MAPS_BROWSER_API_KEY=your-restricted-google-maps-browser-api-key
VITE_GOOGLE_MAP_ID=DEMO_MAP_ID

# ------------------------------------------------------------------------------
# 4. Optional Direct AI Service URL (Development Override Only)
# ------------------------------------------------------------------------------
# Optional: In production, frontend routes all AI requests securely through Express (/api/ai)
# Only specify if bypassing the backend proxy during local standalone testing.
# VITE_AI_SERVICE_URL=http://localhost:8000
