# ==============================================================================
# NAGARSETU 3.1 — Backend Environment Variables (.env.example)
# Service: Node.js + Express REST API
# Deployment: Vercel Serverless Function (Production) / Node.js Server (Local)
#
# IMPORTANT: Never commit actual secret keys or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Environment
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000

# Reverse Proxy Trust Configuration:
# Set to '1' for single reverse proxy hop (Vercel, Render, AWS ALB, Cloudflare, Nginx)
# Set to 'loopback' for local dev/testing
TRUST_PROXY=1

# ------------------------------------------------------------------------------
# 2. Authentication & Security
# ------------------------------------------------------------------------------
# High-entropy secret key for signing citizen and staff JWT tokens (min 32 chars)
JWT_SECRET=your_long_random_jwt_secret_key_minimum_32_characters

# Developer Super Admin Credentials (used for emergency system administration)
SUPER_ADMIN_USERNAME=devadmin
SUPER_ADMIN_PASSWORD=your_super_admin_high_entropy_password_min_16_chars

# Production Live SMS OTP Gateway API Key (e.g. Fast2SMS, MSG91, Twilio)
SMS_GATEWAY_API_KEY=your_production_sms_gateway_api_key

# Automatic Demo Data Seeding in Production (Defaults to false for safety)
SEED_DEMO_DATA=false

# ------------------------------------------------------------------------------
# 3. Database Configuration (PostgreSQL / Supabase / Neon / Local SQLite)
# ------------------------------------------------------------------------------
# In production on Vercel: DB_TYPE must be 'postgres' and DATABASE_URL is required
DB_TYPE=postgres
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
# Set to 'false' if using self-signed or pooled certificates requiring unauthorized SSL bypass
DB_SSL_REJECT_UNAUTHORIZED=false

# ------------------------------------------------------------------------------
# 4. CORS & Allowed Origins
# ------------------------------------------------------------------------------
# Primary frontend URL allowed to make cross-origin requests
FRONTEND_URL=https://your-frontend-project.vercel.app
# Comma-separated list of additional allowed origins
CORS_ALLOWED_ORIGINS=https://your-frontend-project.vercel.app,http://localhost:5173

# ------------------------------------------------------------------------------
# 5. AI Computer Vision Microservice Connection
# ------------------------------------------------------------------------------
# FastAPI microservice endpoint URL (Render, Railway, Fly.io, or localhost)
# Both PYTHON_AI_URL and AI_SERVICE_URL are supported. Can be base URL or /analyze.
PYTHON_AI_URL=https://your-ai-service.onrender.com/analyze
AI_SERVICE_URL=https://your-ai-service.onrender.com

# Shared secret key passed in X-Internal-API-Key header to authenticate with Python service
AI_INTERNAL_API_KEY=your_shared_internal_api_secret_key
AI_SERVICE_API_KEY=your_shared_internal_api_secret_key

# ------------------------------------------------------------------------------
# 6. Supabase Cloud Storage (Citizen Uploads & Evidence Images)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
# Service Role Key is required for backend to upload evidence photos to 'issues' bucket
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_private_key
SUPABASE_ANON_KEY=your_supabase_anon_public_key

# ------------------------------------------------------------------------------
# 7. Distributed Rate Limiting (Redis / Upstash KV) — Optional
# ------------------------------------------------------------------------------
# Optional: In multi-instance serverless deployments, syncs rate limits across instances.
# Falls back to in-memory store if unset.
REDIS_URL=rediss://default:your-token@your-redis-host.upstash.io:6379
# KV_REST_API_URL=https://your-upstash-kv-rest-api.upstash.io

# Rate Limit Thresholds (Defaults shown)
# RATE_LIMIT_AUTH_WINDOW_MS=900000
# RATE_LIMIT_AUTH_MAX=5
# RATE_LIMIT_AUTH_BACKOFF_BASE_SEC=30
# RATE_LIMIT_PUBLIC_WINDOW_MS=900000
# RATE_LIMIT_PUBLIC_MAX=100
# RATE_LIMIT_AUTHED_WINDOW_MS=900000
# RATE_LIMIT_AUTHED_MAX=300

# ------------------------------------------------------------------------------
# 8. File Upload Configuration — Optional
# ------------------------------------------------------------------------------
# MAX_UPLOAD_SIZE_MB=10
# MAX_UPLOAD_SIZE_BYTES=10485760

# ------------------------------------------------------------------------------
# 9. Blockchain & Audit Trail Integrity — Optional
# ------------------------------------------------------------------------------
# Secret for HMAC cryptographic hash chaining for complaint audit immutability
BLOCKCHAIN_HMAC_SECRET=your_32_character_blockchain_hmac_secret_key
BLOCKCHAIN_NETWORK=nagarsetu-permissioned-consortium
BLOCKCHAIN_CHANNEL=nagarsetu-channel
BLOCKCHAIN_NODE_ID=node-peer0.municipal.nagarsetu.gov.in
KMS_PROVIDER=ENV_VAULT
BLOCKCHAIN_KEY_VERSION=v1-2026-master

# Hyperledger Fabric Enterprise Gateway (Optional)
# FABRIC_PEER_ENDPOINT=grpcs://peer0.org1.example.com:7051
# FABRIC_MSP_ID=MunicipalAuthorityMSP
# FABRIC_CHANNEL=nagarsetu-channel
# FABRIC_CHAINCODE=nagarsetu-integrity
# FABRIC_TLS_CERT_PATH=/etc/hyperledger/tls/ca.crt
# FABRIC_CLIENT_CERT_PATH=/etc/hyperledger/users/Admin@org1.example.com/msp/signcerts/cert.pem
# FABRIC_CLIENT_KEY_PATH=/etc/hyperledger/users/Admin@org1.example.com/msp/keystore/priv_sk

# ------------------------------------------------------------------------------
# 10. Development & Demo Password Overrides — Optional
# ------------------------------------------------------------------------------
# DEMO_CITIZEN_PASSWORD=citizen123
# DEMO_ADMIN_PASSWORD=admin123
# DEMO_STAFF_PASSWORD=staff123
# DEMO_HEAD_PASSWORD=head123
# DEMO_USER_PASSWORD=password123
