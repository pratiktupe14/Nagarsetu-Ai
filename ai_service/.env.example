# ==============================================================================
# NAGARSETU 3.1 — AI Microservice Environment Variables (.env.example)
# Service: Python + FastAPI + Ultralytics YOLOv8 + LangGraph
# Deployment: Render, Railway, Fly.io, Cloud Run, or Docker (Local/Cloud)
#
# IMPORTANT: Never commit actual secret keys or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
PORT=8000
ENVIRONMENT=production
# NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. Internal Microservice Authentication
# ------------------------------------------------------------------------------
# Enforced in production (ENVIRONMENT=production). The Express backend sends this
# value in the 'X-Internal-API-Key' header on all requests (/analyze, /google-maps/*).
AI_INTERNAL_API_KEY=your_shared_internal_api_secret_key

# ------------------------------------------------------------------------------
# 3. CORS & Allowed Origins
# ------------------------------------------------------------------------------
# Comma-separated list of origins allowed to make browser requests.
# Typically includes the Express backend and optionally the frontend domain.
CORS_ALLOWED_ORIGINS=https://backend-teal-omega-46.vercel.app,https://your-frontend-project.vercel.app

# ------------------------------------------------------------------------------
# 4. Google Maps Platform Server-Side API Key (Optional)
# ------------------------------------------------------------------------------
# Used for backend geocoding, reverse geocoding, and route calculation.
# Enable 'Geocoding API' and 'Directions API' in Google Cloud Console.
GOOGLE_MAPS_API_KEY=your_google_maps_backend_api_key

# ------------------------------------------------------------------------------
# 5. Pre-Trained YOLOv8 Model Weight Paths (Optional)
# ------------------------------------------------------------------------------
# By default, weights are loaded from the ai_service/model/ directory.
# Override only if mounting custom volumes or alternative storage paths.
# WASTE_MODEL_PATH=model/best.pt
# POTHOLE_MODEL_PATH=model/civicmodel.pt
# WATER_PIPE_MODEL_PATH=model/water_pipe_model.pt
# DRAINAGE_MODEL_PATH=model/drainage_model.pt

# ------------------------------------------------------------------------------
# 6. Detection Confidence & Severity Thresholds (Optional)
# ------------------------------------------------------------------------------
# Defaults match civic model training validation:
# AI_CONFIDENCE_THRESHOLD=0.45
# AI_HIGH_CONFIDENCE_THRESHOLD=0.75
# AI_MIN_DETECTION_CONFIDENCE=0.25
# POTHOLE_CRITICAL_RATIO=0.20
# POTHOLE_MEDIUM_RATIO=0.08
